@startuml RefreshJWTSequence
participant "Frontend (React)" as FE
participant "/api/v1/auth/refresh route\n(Flask Blueprint)" as ARfR
participant "AuthService" as AS
participant "UserService" as US
participant "WhitelistedJWTRefreshToken Model\n(SQLAlchemy -> Database)" as WM

== (Generic) Refresh JWT ==
activate FE
FE -> ARfR: HTTP Request: POST\n{expired access_jwt, encoded_refresh_jwt, user_agent, ip_address}
deactivate FE
activate ARfR
ARfR -> AS : verify_refresh_request(access_jwt, encoded_refresh_jwt)
activate AS
AS -> AS : __decode_jwt(access_jwt)
activate AS
alt Decoding access JWT fails
    AS <-- AS : None
    ARfR <-- AS : None
    note right of ARfR : Revoke JWT: see sep. generic diagram.
end
AS <-- AS : decoded_access_jwt
deactivate AS
AS -> AS : __is_access_jwt(decoded_access_jwt)
activate AS
alt Token is not an access JWT
    AS <-- AS : False
    ARfR <-- AS : None
    note right of ARfR : Revoke JWT: see sep. generic diagram.
end
AS <-- AS : True
deactivate AS
AS -> AS : __has_jwt_expired(decoded_access_jwt)
activate AS
alt access JWT has not expired
    AS <-- AS : False
    note right of AS : Note: only expired access token authorize for new access token
    ARfR <-- AS : None
    note right of ARfR : Revoke JWT: see sep. generic diagram.
end
AS <-- AS : True
deactivate AS
AS -> AS : __query_blacklisted_jwt_by_jti(access_jti)
activate AS
alt access_jti is blacklisted
    AS <-- AS : BlacklistedJWTAccessToken
    ARfR <-- AS : None
    note right of ARfR : Revoke JWT: see sep. generic diagram.
end
AS <-- AS : None
deactivate AS
AS -> AS : __decode_jwt(refresh_jwt)
activate AS
alt Decoding refresh JWT fails
    AS <-- AS : None
    ARfR <-- AS : None
    note right of ARfR : Revoke JWT: see sep. generic diagram.
end
AS <-- AS : decoded_refresh_jwt
deactivate AS
AS -> AS : __is_refresh_jwt(decoded_refresh_jwt)
activate AS
alt Token is not a refresh JWT
    AS <-- AS : False
    ARfR <-- AS : None
    note right of ARfR : Revoke JWT: see sep. generic diagram.
end
AS <-- AS : True
deactivate AS
AS -> AS : __does_jti_match(refresh_jti_from_access_jwt, refresh_jti_from_refresh_jwt)
activate AS
alt jti does not match
    AS <-- AS : False
    ARfR <-- AS : None
    note right of ARfR : Revoke JWT: see sep. generic diagram.
    end
    AS <-- AS : True
deactivate AS
AS -> AS : __has_jwt_expired(decoded_refresh_jwt)
activate AS
alt refresh JWT has expired
    AS <-- AS : True
    ARfR <-- AS : None
    note right of ARfR : Revoke JWT: see sep. generic diagram.
end
AS <-- AS : False
deactivate AS
AS -> AS : __query_whitelisted_jwt_by_jti_user_agent(jti, user_agent)
activate AS
alt Refresh JWT not on Whitelist
    AS <-- AS : None
    ARfR <-- AS : None
    note right of ARfR : Revoke JWT: see sep. generic diagram.
end
AS <-- AS : whitelisted_jwt_refresh_token
deactivate AS
AS -> WM : verify_token(encoded_refresh_jwt)
activate WM
WM -> WM : __hash_secret(encoded_refresh_jwt)
activate WM
deactivate WM
alt  refresh_token does not match
    AS <-- WM : False
    ARfR <-- AS : None
    note right of ARfR : Revoke JWT: see sep. generic diagram.
end
AS <-- WM : True
deactivate WM
AS -> US : query_users_by_id(user_id)
activate US
alt User does not exist
    AS <-- US : None
    ARfR <-- AS : None
    note right of ARfR : Revoke JWT: see sep. generic diagram.
end
AS <-- US : User object
deactivate US
AS -> WM : delete(whitelisted_jwt_refresh_token)
activate WM
deactivate WM
ARfR <-- AS : User object
deactivate AS
note right of ARfR : Create JWT: see sep. generic diagram.
FE <-- ARfR : HTTP Response: 200 OK\n{new_access_jwt, new_refresh_jwt}
deactivate ARfR
activate FE
FE -> FE : store access_jwt and encoded_refresh_jwt in HTTP only cookie
deactivate FE
@enduml