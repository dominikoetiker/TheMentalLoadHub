@startuml UpdateAccountSequence
actor "Account User" as AU
participant "Frontend (React)" as FE
participant "/update_account route\n(Flask Blueprint)" as UR
participant "UserService" as US
participant "EmailVerificationService" as ES

== Update Account Process ==
AU -> FE: Navigates to update account form
FE -> AU: Display form
AU -> FE: Submits update with {new_email, new_password}
FE -> UR: HTTP Request: PUT {user_id, new_email, new_password}
activate UR
UR -> US: update_user_account(user_id, new_email, new_password)
activate US
alt Email is updated
    US -> ES: create_verification_token()
    activate ES
    ES -> ES: __create_verification_link(new_verification_token, new_email)
    deactivate ES
    US <- ES: verification_link
    US -> US: update user record (set unverified_email, verification_token, verification_exp_at)
    US -> ES: send_verification_mail(verification_link, new_email)
end
US --> UR: Updated User Object
deactivate US
UR --> FE: HTTP Response: 200 OK {updated_user_info}
deactivate UR
FE -> AU: Show success message and instructions (check email if updated)
@enduml
